# Reference material (contains the original notebook with credentials; never commit)
# No trailing slash, so a symlink in a sibling worktree matches too.
/references

# Secrets and local environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv*/
.python-version.local

# Tooling caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
coverage.xml
htmlcov/

# Experiment outputs
/results
*.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store

